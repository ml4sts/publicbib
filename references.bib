  author = {Hutchison, R. Matthew and Womelsdorf, Thilo and family=Allen, given=Elena, prefix=a., useprefix=true and family=Bandettini, given=Peter, prefix=a., useprefix=true and Calhoun, Vince D. and Corbetta, Maurizio and Della Penna, Stefania and Duyn, Jeff H. and Glover, Gary H. and Gonzalez-Castillo, Javier and family=Handwerker, given=Daniel, prefix=a., useprefix=true and Keilholz, Shella and Kiviniemi, Vesa and family=Leopold, given=David, prefix=a., useprefix=true and family=Pasquale, given=Francesco, prefix=de, useprefix=true and Sporns, Olaf and Walter, Martin and Chang, Catie},
