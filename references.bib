  keywords = {brain-functionalities,brain-models,circuitry,computational-neuroscience,graph-theory,hypergraphs,hypernetworks,neuronal-structures},
  file = {/Users/brownsarahm/Zotero/storage/AARCF46N/Bullmore et al. - 2009 - Complex brain networks graph theoretical analysis of structural and functional systems(3).pdf}
}

